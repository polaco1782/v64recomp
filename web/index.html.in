<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>@RECOMP_WEB_TITLE@ · v64recomp</title>
<link rel="icon" href="data:,">
<style>
:root{color-scheme:dark;font:16px system-ui;background:#11151d;color:#e8edf5}body{max-width:1000px;margin:32px auto;padding:0 20px}h1{font-size:26px}p{line-height:1.5;color:#bbc8db}button{padding:10px 20px;background:#6cafff;border:0;border-radius:6px;color:#101722;font:inherit;cursor:pointer}canvas{display:block;width:100%;aspect-ratio:4/3;background:#000;outline:0}canvas:focus{box-shadow:0 0 0 2px #6cafff}pre{white-space:pre-wrap;max-height:240px;overflow:auto;font-size:12px}
</style>
<h1>@RECOMP_WEB_TITLE@</h1>
<p id="status" role="status">Loading game…</p>
<canvas id="canvas" width="960" height="720" tabindex="0" aria-label="Game screen"></canvas>
<p>Click the game for keyboard controls and audio. A connected gamepad also works.</p>
<button id="cheats" hidden>Cheats</button>
<button id="save" hidden>Download save</button>
<label id="mediaControl" hidden>Open MP3 <input id="media" type="file" accept=".mp3,audio/mpeg"></label>
<details><summary>Diagnostics</summary><pre id="log"></pre></details>
<script src="@RECOMP_GAME@.js"></script>
<script>
'use strict';
const state = document.getElementById('status');
const canvas = document.getElementById('canvas');
const save = document.getElementById('save');
const saveName = '@RECOMP_WEB_SAVE@';
const log = document.getElementById('log');
let game;
function report(text) {
    log.textContent = (log.textContent + text + '\n').slice(-24000);
    log.scrollTop = log.scrollHeight;
}
function fail(error) {
    state.textContent = String(error);
    report(error);
}
async function loadRom() {
    const response = await fetch('@RECOMP_GAME@.z64');
    if (!response.ok) throw new Error('Could not load the game ROM (HTTP ' + response.status + ').');
    return new Uint8Array(await response.arrayBuffer());
}
async function initialize() {
    if (!crossOriginIsolated) throw new Error('This page requires COOP/COEP headers. Use tools/serve_web.py.');
    const [module, rom] = await Promise.all([
        createGame({canvas, noInitialRun: true, print: report, printErr: report,
            onAbort: reason => fail('Game stopped: ' + reason),
            onExit: code => { state.textContent = 'Game exited (' + code + '). Reload to play again.'; }}),
        loadRom()
    ]);
    game = module;
    game.FS.writeFile('/rom.z64', rom, {canOwn: true});
    const hasCheats = typeof game._recomp_web_toggle_cheats === 'function' && !game._recomp_web_open_media;
    if (hasCheats) {
        const cache = '/local/rt64/@RECOMP_GAME@/cheats';
        game.FS.mkdirTree(cache);
        game.FS.mount(game.IDBFS, {autoPersist: true}, cache);
    }
    if (saveName) {
        game.FS.mkdir('/saves');
        game.FS.mount(game.IDBFS, {autoPersist: true}, '/saves');
        save.hidden = false;
    }
    if (saveName || hasCheats)
        await new Promise((resolve, reject) => game.FS.syncfs(true, error => error ? reject(error) : resolve()));
    if (hasCheats) {
        document.getElementById('cheats').hidden = false;
        canvas.addEventListener('keydown', event => {
            if (event.code === 'F11' || event.code === 'F12') event.preventDefault();
        });
    }
    if (game._recomp_web_open_media) document.getElementById('mediaControl').hidden = false;
    canvas.focus();
    state.textContent = 'Running';
    game.callMain([]);
}
document.getElementById('cheats').addEventListener('click', () => {
    canvas.focus();
    game._recomp_web_toggle_cheats();
});
save.addEventListener('click', () => {
    try {
        const bytes = game.FS.readFile('/saves/' + saveName);
        const url = URL.createObjectURL(new Blob([bytes], {type: 'application/octet-stream'}));
        const link = document.createElement('a');
        link.href = url;
        link.download = saveName;
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
    } catch (error) { state.textContent = 'No save has been written yet.'; }
});
const media = document.getElementById('media');
media.addEventListener('change', async () => {
    const file = media.files[0];
    if (!file) return;
    try {
        game.FS.writeFile('/incoming.mp3', new Uint8Array(await file.arrayBuffer()));
        game.FS.rename('/incoming.mp3', '/selected.mp3');
        game._recomp_web_open_media();
        canvas.focus();
    } catch (error) { fail(error); }
});
canvas.addEventListener('click', () => canvas.focus());
window.addEventListener('error', event => fail(event.message || 'Runtime error'));
initialize().catch(fail);
</script>
</html>
