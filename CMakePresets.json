    {
      "name": "game",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}$penv{V64_BUILD_SUFFIX}",
      "cacheVariables": {
        "RECOMP_GAME": "${presetName}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows x64 MSVC Release",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-msvc-release",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "RECOMP_GAME": "none",
        "RECOMP_BUILD_RT64": "ON",
        "RECOMP_BUILD_AUDIO": "ON",
        "RECOMP_EMBED_ROM": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      }
    },
