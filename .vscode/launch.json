{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Super Mario 64",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/sm64_native_full_rt64",
            "args": [
                "${workspaceFolder}/local/sm64.us.z64",
                "${workspaceFolder}/build/sm64-us/rom/full",
                "${workspaceFolder}/local/saves/sm64-us.eeprom",
                "0",
                "live"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [
                {
                    "name": "SDL_VIDEODRIVER",
                    "value": "x11"
                },
                {
                    "name": "MESA_SHADER_CACHE_DIR",
                    "value": "${workspaceFolder}/local/rt64/mesa-cache"
                },
                {
                    "name": "RECOMP_AUDIO_MUTE",
                    "value": "0"
                },
                {
                    "name": "RECOMP_CAPTURE",
                    "value": "0"
                },
                {
                    "name": "RECOMP_AUDIO_PLAYBACK",
                    "value": "0"
                },
                {
                    "name": "RECOMP_TEXTURE_DUMP",
                    "value": ""
                },
                {
                    "name": "RECOMP_TEXTURE_REPLACEMENTS",
                    "value": "${workspaceFolder}/local/textures/sm64-us/replacements"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Debug: Super Mario 64"
        },
