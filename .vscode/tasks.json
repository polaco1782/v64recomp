{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Prepare debug directories",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-c",
                "from pathlib import Path; [Path(p).mkdir(parents=True, exist_ok=True) for p in ('local/saves', 'local/rt64/mesa-cache')]"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build Debug: Super Mario 64",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/games/sm64-us/run_sm64.py",
                "--render",
                "--debug",
                "--build-only",
                "--jobs",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Prepare debug directories"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
