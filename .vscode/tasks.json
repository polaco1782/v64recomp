{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Debug: Super Mario 64 US",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "sm64-us-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Debug: Super Mario 64 US",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "sm64-us-debug",
        "-j",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Configure Debug: Super Mario 64 US",
      "problemMatcher": [
        "$gcc"
