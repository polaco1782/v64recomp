/* Local defaults; command-line options override them at launch. */
#define RECOMP_GAME_ID "@RECOMP_GAME@"
#define RECOMP_EMBEDDED_ROM_PATH ":embedded:"
#ifdef RECOMP_EMBED_ROM
#define RECOMP_DEFAULT_ROM RECOMP_EMBEDDED_ROM_PATH
#else
#define RECOMP_DEFAULT_ROM "@RECOMP_ROM@"
#endif
#define RECOMP_DEFAULT_SAVE "@RECOMP_SAVE@"
#define RECOMP_DEFAULT_CRASH "@RECOMP_LOCAL@/crashes/@RECOMP_GAME@"
#define RECOMP_DEFAULT_LIVE_PATCH_DIR "@RECOMP_LOCAL@/live-patches/@RECOMP_GAME@"
#define RECOMP_DEFAULT_LIVE_PYTHON "@Python3_EXECUTABLE@"
#define RECOMP_DEFAULT_LIVE_SCRIPT "@CMAKE_SOURCE_DIR@/tools/auto_live_function.py"
#define RECOMP_DEFAULT_LIVE_BUILD_DIR "@CMAKE_BINARY_DIR@"
#define RECOMP_DEBUG_OUTPUT "@CMAKE_BINARY_DIR@/debug-output/@RECOMP_GAME@"
