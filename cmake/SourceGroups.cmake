# Source browsing in native IDE projects. This only changes project presentation.
function(recomp_source_groups target)
    get_target_property(target_sources "${target}" SOURCES)
    get_target_property(target_directory "${target}" SOURCE_DIR)
    set(sources)
    set(headers)
    set(metadata)
    set(generated)
    foreach(source IN LISTS target_sources)
        if(source MATCHES "^\\$<")
            continue()
        endif()
        get_filename_component(path "${source}" ABSOLUTE BASE_DIR "${target_directory}")
        cmake_path(IS_PREFIX CMAKE_BINARY_DIR "${path}" NORMALIZE in_build)
        cmake_path(IS_PREFIX CMAKE_SOURCE_DIR "${path}" NORMALIZE in_source)
        if(in_build)
            list(APPEND generated "${path}")
        elseif(in_source)
            if(path MATCHES "\\.(h|hpp|hxx|inl)$")
                list(APPEND headers "${path}")
            elseif(path MATCHES "\\.(c|cpp|cc|cxx)$")
                list(APPEND sources "${path}")
            else()
                list(APPEND metadata "${path}")
            endif()
        endif()
    endforeach()
    if(sources)
        source_group(TREE "${CMAKE_SOURCE_DIR}" PREFIX "Source Files" FILES ${sources})
    endif()
    if(headers)
        source_group(TREE "${CMAKE_SOURCE_DIR}" PREFIX "Header Files" FILES ${headers})
    endif()
    if(metadata)
        source_group(TREE "${CMAKE_SOURCE_DIR}" PREFIX "Configuration" FILES ${metadata})
    endif()
    if(generated)
        source_group(TREE "${CMAKE_BINARY_DIR}" PREFIX "Generated Code" FILES ${generated})
    endif()
    source_group("Build Rules" REGULAR_EXPRESSION "CMakeLists\\.txt$|\\.rule$")
endfunction()
